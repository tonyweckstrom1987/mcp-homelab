{
  "name": "mcp-homelab",
  "version": "0.1.0",
  "description": "Vain-luku MCP-palvelin Proxmoxille: listaa solmut ja LXC-kontit sekä niiden tilan ja resurssit. / Read-only MCP server for Proxmox VE: nodes, LXC containers, status and resource usage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "bin": {
    "mcp-homelab": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
